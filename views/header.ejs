<!DOCTYPE html>
<html>

<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

</head>
<body>
  
<nav style="background: #333; padding: 1rem; color: white;">
  <a href="/" style="color: white; margin-right: 1rem;">Blogaroo</a>
  <% if (user) { %>
    <a href="/create" style="color: white; margin-right: 1rem;">Create Post</a>
    <a href="/logout" style="color: white; margin-right: 1rem;">Logout</a>
    <form action="/search" method="GET" style="display: inline;">
      <input type="text" name="query" placeholder="Search..." />
      <button type="submit">Go</button>
    </form>
    <% } else { %>
      <a href="/login" style="color: white; margin-right: 1rem;">Login</a>
      <a href="/register" style="color: white; margin-right: 1rem;">Register</a>
      <% } %>

        
        
</nav>
</body>
</html>