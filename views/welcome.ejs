<%- include('./header') %>

<div style="padding: 2rem;">
  <% if (user) { %>
    <h1>Welcome, <%= user.username %>!</h1>
    <p>
      <a href="/create">Create a Blog Post</a> |
      <a href="/posts">View All Posts</a>
    </p>
  <% } else { %>
    <h1>Welcome to Blogaroo!</h1>
    <p>
      <a href="/login">Login</a> or
      <a href="/register">Register</a>
    </p>
  <% } %>
</div>
