<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Post - Blogaroo</title>
</head>
<body>
  <%- include('./header') %>

  <h1>Edit Post </h1>

  <form method="POST" action="/edit/<%= post.id %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><!-- CSRF protection token -->
    <label>Title:</label><br>
    <input type="text" name="title" value="<%= post.title %>" required><br><br>

    <label>Content:</label><br>
    <textarea name="content" rows="10" cols="30" required><%= post.content %></textarea><br><br>

    <button type="submit">Update</button>
  </form>
  <form method="POST" action="/delete/<%= post.id %>" style="display:inline;">
    <button type="submit" >Delete</button>
  </form>
  <p><a href="/posts">Back to Posts</a></p>
</body>
</html>
